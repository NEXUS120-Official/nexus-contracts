# deployer
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# governance/admin
ADMIN=0xYourAdminAddress
KEEPER=0xYourKeeperAddress

# network-specific external contracts
ORACLE_FEED=0xYourArbitrumSepoliaOracleFeed
COLLATERAL_TOKEN=0xYourArbitrumSepoliaCollateralToken

# oracle / vault policy
ORACLE_MAX_DELAY=3600
VAULT_MAX_DELAY=3600

# protocol ratios
MIN_COLLATERAL_RATIO_BPS=15000
LIQUIDATION_RATIO_BPS=13000
CLOSE_FACTOR_BPS=5000

# rpc
ARBITRUM_SEPOLIA_RPC_URL=https://your-arbitrum-sepolia-rpc
